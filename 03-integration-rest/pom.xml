<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fr.formation.banque</groupId>
        <artifactId>java-test-formation</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>03-integration-rest</artifactId>
    <name>03 - Integration REST</name>
    <description>Controller REST : slice @WebMvcTest et test de la couche HTTP avec RestTestClient, service mocke</description>

    <dependencies>
        <!-- Apporte le domaine (01) ET la persistance PostgreSQL (02). L'auto-
             configuration JDBC/JPA/Flyway est exclue dans les tests : voir
             la classe de test TestCoucheRest. -->
        <dependency>
            <groupId>fr.formation.banque</groupId>
            <artifactId>02-integration-bdd</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ATTENTION Spring Boot 4 : @WebMvcTest et @AutoConfigureMockMvc ont
             quitte spring-boot-test-autoconfigure.
             Package : org.springframework.boot.webmvc.test.autoconfigure -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- RestTestClient : le client de test bout en bout de Spring Boot 4,
             qui remplace TestRestTemplate. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Pas de Testcontainers ici : les tests de ce module s'arretent a la
             couche REST et mockent le service. La base de donnees se teste au
             chapitre 02, la chaine complete au chapitre 04. -->

    </dependencies>
</project>
